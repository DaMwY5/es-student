   0.500 <-- button           button state and press count
   0.500 <-- pi_start         start calculation: pi_start [<terms>]
   0.500 <-- pi               calculation state or result
   0.500 <-- profiling        stopwatch results
   0.500 <-- profiling_reset  reset stopwatches
   0.500 <-- edge             rise and fall of the RC line: edge pp|od
   0.500 <-- loop             UART0 loopback: loop internal|pins
   0.500 <-- echo             send and receive with UART0: echo <text>
   0.500 <-- link             UART0 to UART1 and back: link <text>
   0.500 <-- baud_shift       UART1 baud offset: baud_shift <percent>
   0.500 <-- text             send 32 characters from UART1 to UART0
   0.500 <-- parity           UART0 and UART1 parity: none, even, odd
   0.500 <-- block            receive 64 bytes: block irq|poll
   0.500 <-- scope            UART0 line on ADC: scope <baud> <text>
